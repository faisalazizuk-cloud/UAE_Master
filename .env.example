# TradeTracker Environment Configuration
# Copy this file to .env and fill in your values

# Backend
SECRET_KEY=change-me-to-a-random-string
ADMIN_EMAIL=admin@tradetracker.local
ADMIN_PASSWORD=admin123

# SEC EDGAR (required - just needs a valid email for User-Agent)
SEC_EDGAR_USER_AGENT=TradeTracker your-email@example.com

# OpenAI API (optional - for AI news summaries)
OPENAI_API_KEY=

# NewsAPI (optional - for fetching financial news)
NEWS_API_KEY=

# Frontend
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string

# SMTP (optional - for email notifications, defaults to local MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tradetracker.local
